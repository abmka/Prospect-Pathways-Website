# Copy to .env.local (never commit that file). Set the same three in Vercel → Project → Settings → Environment Variables.

# Resend API key — free at https://resend.com (3,000 emails/month on the free tier)
RESEND_API_KEY=

# Where form submissions are delivered. Comma-separate for more than one inbox.
CONTACT_TO_EMAIL=referrals@prospectpathways.co.uk

# Sender. Until you verify your own domain in Resend, leave this unset and it will
# use Resend's shared onboarding address.
CONTACT_FROM_EMAIL=Prospect Pathways website <website@prospectpathways.co.uk>
